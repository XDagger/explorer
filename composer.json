{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "xdag/explorer",
    "type": "project",
    "description": "XDAG block explorer",
    "keywords": ["xdag", "explorer"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-bcmath": "*",
        "bcncommerce/json-stream": "^0.4.2",
        "erusev/parsedown": "^1.7",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php -r \"if (!file_exists('.env.testing')) { fwrite(STDERR, PHP_EOL . '  .env.testing is missing, aborting to avoid running against the development database.' . PHP_EOL . '  Copy .env.testing.example to .env.testing, run php artisan key:generate --env=testing and fill in the test database credentials.' . PHP_EOL . PHP_EOL); exit(1); }\" @no_additional_args",
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan migrate:fresh --seed --force --env=testing --ansi @no_additional_args",
            "@php artisan optimize:clear --env=testing --ansi @no_additional_args",
            "@php artisan test --parallel",
            "@php artisan optimize:clear --env=testing --ansi @no_additional_args"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
